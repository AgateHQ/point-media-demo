# Optional locally: a development secret is supplied when NODE_ENV is not production.
# Set a long random value before running a production build/server.
PAYLOAD_SECRET=

# Defaults to cms/data/payload.db and cms/media. fly.toml sets these on the persistent volume.
# DATABASE_URL=file:/data/payload.db
# MEDIA_DIR=/data/media

# Optional: reader Vite origin when it is not running on the same host at port 5173.
# READER_DEV_ORIGIN=http://localhost:5174
